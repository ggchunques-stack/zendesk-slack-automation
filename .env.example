# Zendesk webhook validation
ZENDESK_WEBHOOK_SECRET=replace-with-your-webhook-secret
DEBUG_WEBHOOK_SIGNATURE=false
SIGNATURE_TOLERANCE_SECONDS=300

# Dry run: true = do not update Zendesk tickets
# Note: Portuguese Zendesk UI values for priority/status are normalized automatically
ZENDESK_DRY_RUN=true

# Debug override: force Slack notification
DEBUG_FORCE_NOTIFY=false

# Slack incoming webhook (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME

# Zendesk API credentials (required for ticket updates and debug Zendesk endpoints)
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=you@example.com
ZENDESK_API_TOKEN=replace-with-your-api-token
ZENDESK_ADD_INTERNAL_COMMENT=false

# Environment
ENV=dev

# Optional paths
DATABASE_PATH=./data.db
MAPPING_PATH=./config/mapping.json

# Signature headers (optional)
SIGNATURE_HEADER_CANDIDATES=X-Zendesk-Webhook-Signature,X-Zendesk-Signature,X-Hub-Signature-256
SIGNATURE_TIMESTAMP_HEADER=X-Zendesk-Webhook-Signature-Timestamp
